---
/**
 * Layout raíz: todo lo que va entre <html> y </html>.
 * Las metas de SEO completas (Open Graph, canónicas, JSON-LD) llegan en T12;
 * aquí solo el mínimo válido para que el documento sea correcto desde el primer día.
 */
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'Bar El Jardín · Bar en Bolnuevo, Mazarrón',
  descripcion = 'Bar rodeado de flores y plantas en Bolnuevo (Mazarrón, Murcia). Especialidades de la casa, bratwurst, currywurst y tabla de jamón serrano.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <!-- Iconos (T3): la «J» roja sobre baldosa verde del propio logo. -->
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Las dos tipografías se usan por encima del pliegue: se precargan para
         evitar el salto de texto al pasar de la fuente del sistema a la nuestra. -->
    <link
      rel="preload"
      href="/fonts/fredoka-latin-400_600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400_700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
