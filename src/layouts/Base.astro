---
/**
 * Layout raíz: todo lo que va entre <html> y </html>.
 *
 * Las metas de SEO completas (Open Graph, canónicas, JSON-LD) llegan en T12; aquí
 * solo el mínimo válido. La cabecera y el pie viven aquí para que cualquier página
 * los tenga sin repetirlos.
 *
 * El JS de cliente se arranca desde este layout y no desde cada componente: es el
 * único punto de entrada, y cada módulo se activa solo si encuentra su marcador.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  /**
   * En la portada el pie va **dentro de la película**, como última escena. El resto
   * de páginas llevan el pie normal al final del documento.
   */
  pie?: boolean;
  /**
   * `claro` para las páginas sobre fondo crema —las legales—: la cabecera cambia a tinta
   * oscura, porque el crema sobre crema no se lee.
   */
  tema?: 'claro';
}

const {
  titulo = 'Bar El Jardín · Bar en Bolnuevo, Mazarrón',
  descripcion = 'Bar rodeado de flores y plantas en Bolnuevo (Mazarrón, Murcia). Especialidades de la casa, bratwurst, currywurst y tabla de jamón serrano.',
  pie = true,
  tema,
} = Astro.props;

/** Dirección absoluta de esta página, para la canónica y para Open Graph. */
const canonica = new URL(Astro.url.pathname, Astro.site ?? 'https://bareljardin.netlify.app').href;

/** La imagen que enseñan WhatsApp, Telegram y las redes al compartir el enlace. */
const imagenSocial = new URL('/og.jpg', Astro.site ?? 'https://bareljardin.netlify.app').href;
---

<!doctype html>
<html lang="es" data-tema={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    {/* Canónica: una sola dirección por página. Sin esto, la misma página se sirve con y
        sin barra final y Google indexa las dos. */}
    <link rel="canonical" href={canonica} />

    {/* Al compartir por WhatsApp, Telegram o Twitter. La imagen es la fachada del bar en
        1200×630, que es la medida que piden todas. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bar El Jardín" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La fachada del Bar El Jardín en Bolnuevo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenSocial} />

    {/* El verde del Jardín en la barra del navegador del móvil. */}
    <meta name="theme-color" content="#004320" />

    <!-- Iconos (T3): la «J» roja sobre baldosa verde del propio logo. -->
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Las dos tipografías se usan por encima del pliegue: se precargan para
         evitar el salto de texto al pasar de la fuente del sistema a la nuestra. -->
    <link
      rel="preload"
      href="/fonts/fredoka-latin-400_600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400_700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Sin JavaScript la web monta los apartados en capas que nadie enciende: esta hoja
         los pone en columna para que el texto se lea igual. Solo se descarga sin guion. -->
    <noscript>
      <link rel="stylesheet" href="/sin-js.css" />
    </noscript>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    {pie && <Footer />}
  </body>
</html>

<script>
  import '../scripts/app.js';
</script>
