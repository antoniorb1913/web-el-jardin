---
/**
 * Layout raíz: todo lo que va entre <html> y </html>.
 *
 * Las metas de SEO completas (Open Graph, canónicas, JSON-LD) llegan en T12; aquí
 * solo el mínimo válido. La cabecera y el pie viven aquí para que cualquier página
 * los tenga sin repetirlos.
 *
 * El JS de cliente se arranca desde este layout y no desde cada componente: es el
 * único punto de entrada, y cada módulo se activa solo si encuentra su marcador.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  /**
   * En la portada el pie va **dentro de la película**, como última escena. El resto
   * de páginas llevan el pie normal al final del documento.
   */
  pie?: boolean;
}

const {
  titulo = 'Bar El Jardín · Bar en Bolnuevo, Mazarrón',
  descripcion = 'Bar rodeado de flores y plantas en Bolnuevo (Mazarrón, Murcia). Especialidades de la casa, bratwurst, currywurst y tabla de jamón serrano.',
  pie = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <!-- Iconos (T3): la «J» roja sobre baldosa verde del propio logo. -->
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Las dos tipografías se usan por encima del pliegue: se precargan para
         evitar el salto de texto al pasar de la fuente del sistema a la nuestra. -->
    <link
      rel="preload"
      href="/fonts/fredoka-latin-400_600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400_700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    {pie && <Footer />}
  </body>
</html>

<script>
  import '../scripts/app.js';
</script>
