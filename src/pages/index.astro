---
/**
 * Portada (T5 + T6): recorrido del bar con scroll.
 *
 * Cada `<section>` es solo **recorrido**: mide 300dvh y no tiene contenido visible
 * propio. El texto de cada apartado vive en un `.panel` en `position: fixed`, que no
 * viaja: aparece en la parada de la cámara y se desvanece.
 *
 * «Quiénes somos» va con el logo, en la portada. Así los cinco apartados caen uno por
 * cada parada de cámara —donde se enciende su foto nítida— y la página queda en
 * portada, especialidades, comida, fotos y dónde estamos.
 */
import Base from '../layouts/Base.astro';
import HeroScrolly from '../components/HeroScrolly.astro';
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';
import { direccion, horario, enlaceMapa } from '../data/negocio';

const seccion = 'relative mx-auto max-w-2xl min-h-[300dvh]';
const panel = 'panel';
const texto = 'texto-foto max-w-xl text-center text-crema-50';
const anio = new Date().getFullYear();
---

<Base pie={false}>
  <HeroScrolly>
    <!-- PORTADA: el logo y «Quiénes somos» van juntos, en el mismo sitio -->
    <section id="portada" data-seccion="portada" class="relative min-h-dvh">
      <div class={panel} data-panel>
        <div class="flex flex-col items-center gap-7 text-center">
          <Image src={logo} alt="Bar El Jardín" width={520} class="h-auto w-[min(78vw,520px)]" />
          <p class="texto-foto max-w-xl text-lg leading-relaxed text-crema-50/90">
            Somos un bar que te ofrece una opción creada para disfrutar de un ambiente
            agradable, relajado, sin dejar de lado pasar un rato alegre y rodeado de naturaleza.
          </p>
          <p class="texto-foto text-sm text-crema-50/60">Baja para entrar</p>
        </div>
      </div>
    </section>

    <!-- ESPECIALIDADES -->
    <section id="especialidades" data-seccion="especialidades" class={seccion}>
      <div class={panel} data-panel>
        <div class={texto}>
          <h2 class="text-4xl font-semibold tracking-tight sm:text-6xl">Nuestras especialidades</h2>
          <p class="mt-6 text-lg leading-relaxed text-crema-50/85">
            Kiwi de la casa · Pasión de la casa · Drácula · Aperol · Gin Tonic
          </p>
        </div>
      </div>
    </section>

    <!-- COMIDA -->
    <section id="comida" data-seccion="comida" class={seccion}>
      <div class={panel} data-panel>
        <div class={texto}>
          <h2 class="text-4xl font-semibold tracking-tight sm:text-6xl">Nuestra comida</h2>
          <p class="mt-6 text-lg leading-relaxed text-crema-50/85">
            Salchicha bratwurst · Salchicha currywurst · Tabla de jamón serrano de Teruel
          </p>
        </div>
      </div>
    </section>

    <!-- FOTOS -->
    <section id="fotos" data-seccion="fotos" class={seccion}>
      <div class={panel} data-panel>
        <div class={texto}>
          <h2 class="text-4xl font-semibold tracking-tight sm:text-6xl">Fotos del bar</h2>
          <p class="mt-6 text-lg leading-relaxed text-crema-50/85">La galería llega en T9.</p>
        </div>
      </div>
    </section>

    <!-- CIERRE: el pie, dentro de la película -->
    <section id="ubicacion" data-seccion="ubicacion" class={seccion}>
      <div class={panel} data-panel>
        <div class="cierre texto-foto">
          <h2 class="cierre__titulo">Dónde estamos</h2>

          <p class="cierre__direccion">
            {direccion.calle}<br />
            {direccion.poblacion} ({direccion.provincia})
          </p>

          <dl class="cierre__horario">
            {horario.map((tramo) => (
              <div>
                <dt>{tramo.dias}</dt>
                <dd>{tramo.horas}</dd>
              </div>
            ))}
          </dl>

          <p class="cierre__acciones">
            <a class="cierre__mapa" href={enlaceMapa} target="_blank" rel="noopener noreferrer">
              Cómo llegar
            </a>
          </p>

          <p class="cierre__legal">© {anio} Bar El Jardín · Bolnuevo, Mazarrón</p>
        </div>
      </div>
    </section>
  </HeroScrolly>
</Base>
