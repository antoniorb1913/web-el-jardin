---
/**
 * Portada (T5 + T6): recorrido del bar con scroll.
 *
 * Cada `<section>` es solo **recorrido**: mide 250dvh y no tiene contenido visible
 * propio. El texto de cada apartado vive en un `.panel` en `position: fixed`, que no
 * viaja: aparece en la parada de la cámara y se desvanece.
 *
 * «Quiénes somos» va con el logo, en la portada. Así los cinco apartados caen uno por
 * cada parada de cámara —donde se enciende su foto nítida— y la página queda en
 * portada, especialidades, comida, fotos y dónde estamos.
 */
import Base from '../layouts/Base.astro';
import HeroScrolly from '../components/HeroScrolly.astro';
import Seccion from '../components/Seccion.astro';
import Carta from '../components/Carta.astro';
import Escena from '../components/Escena.astro';
import { direccion, horario, enlaceMapa, redes } from '../data/negocio';
import { bebidas, platos, notaCarta } from '../data/carta';

const seccion = 'relative mx-auto max-w-2xl min-h-[250dvh]';
const panel = 'panel';
const texto = 'texto-foto max-w-xl text-center text-crema-50';
const anio = new Date().getFullYear();
---

<Base pie={false}>
  <HeroScrolly>
    <!-- PORTADA: la foto manda y la tipografía susurra. Un bloque pequeño, apoyado en
         una línea fina, abajo a la izquierda. -->
    <section id="portada" data-seccion="portada" class="relative min-h-dvh">
      <div class={`${panel} panel--cubierta`} data-panel>
        <div class="susurro">
          <p class="susurro__marca">Bar El Jardín · Bolnuevo</p>

          <h1 class="susurro__titular">
            <span class="susurro__linea">Un paraíso</span>
            <span class="susurro__linea">en Bolnuevo</span>
          </h1>

          <p class="susurro__texto">
            Somos un bar que te ofrece una opción creada para disfrutar de un ambiente
            agradable, relajado, sin dejar de lado pasar un rato alegre y rodeado de naturaleza.
          </p>

          {/* La bajada: flecha y etiqueta. La flecha dice cómo se sigue; la etiqueta,
              qué pasa si se pulsa. La zona pulsable mide 44 px de alto. */}
          <a class="susurro__baja" href="#especialidades">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true">
              <path
                d="M12 4v14M6 13l6 6 6-6"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="susurro__bajatexto">Baja y entra</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ESPECIALIDADES -->
    <Carta
      id="especialidades"
      titulo="Nuestras especialidades"
      piezas={bebidas}
      nota={notaCarta}
      texto="Creaciones de autor, combinados clásicos y batidos pensados para detener el tiempo. Elige tu copa, busca tu rincón y déjate llevar por la atmósfera del Jardín."
    />

    <!-- COMIDA -->
    <Carta
      id="comida"
      titulo="Nuestra comida"
      piezas={platos}
      nota={notaCarta}
      texto="Bocados pensados para compartir y disfrutar sin prisas. Desde la auténtica tradición alemana con nuestras Bratwurst y Currywurst, hasta la exquisitez de una tabla de Jamón Serrano de Teruel."
    />

    <!-- FOTOS -->
    <section id="fotos" data-seccion="fotos" class={seccion}>
      <div class={`${panel} panel--escena`} data-panel>
        <Escena />
      </div>
    </section>

    <!-- CIERRE: el pie, dentro de la película -->
    <section id="ubicacion" data-seccion="ubicacion" class={seccion}>
      <div class={panel} data-panel>
        <div class="cierre texto-foto">
          <h2 class="cierre__titulo">Dónde estamos</h2>

          <div class="cierre__texto">
            <p class="cierre__direccion">
              {direccion.calle}<br />
              {direccion.poblacion} ({direccion.provincia})
            </p>

            {/* Lo enciende `horario.js`: dice si está abierto y a qué hora cierra. */}
            <p class="cierre__estado" data-estado-bar>
              <span class="cierre__punto" aria-hidden="true"></span>
              <span data-estado-texto>…</span>
            </p>

            <dl class="cierre__horario">
              {horario.map((tramo) => (
                <div>
                  <dt>{tramo.dias}</dt>
                  <dd>{tramo.horas}</dd>
                </div>
              ))}
            </dl>

            <p class="cierre__acciones">
              <a class="cierre__mapa" href={enlaceMapa} target="_blank" rel="noopener noreferrer">
                Cómo llegar
              </a>
            </p>

            <p class="cierre__legal">© {anio} Bar El Jardín · Bolnuevo, Mazarrón</p>
          </div>

          {/* Redes del bar: a la derecha del texto, en texto y no en iconos, como el resto
              de la web. Todas se abren fuera. */}
          <nav class="cierre__redes" aria-label="Redes del bar">
            <p class="cierre__redes-titulo">Síguenos</p>
            <ul class="cierre__redes-lista">
              {redes.map((red) => (
                <li>
                  <a href={red.url} target="_blank" rel="noopener noreferrer">
                    {/* Iconos dibujados aquí mismo, sin librerías ni CDN. Heredan el color
                        del texto, así que no rompen la paleta. */}
                    {red.icono === 'facebook' && (
                      <svg class="cierre__red-icono" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          fill="currentColor"
                          d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.3-.13-2.47-.13-2.44 0-4.11 1.49-4.11 4.23v2.36H7.3V13h2.32v8z"
                        />
                      </svg>
                    )}
                    {red.icono === 'instagram' && (
                      <svg class="cierre__red-icono" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          fill="currentColor"
                          d="M12 4.6c2.4 0 2.7 0 3.6.05.9.04 1.4.19 1.7.31.4.16.7.35 1 .65.3.3.49.6.65 1 .12.3.27.8.31 1.7.04.9.05 1.2.05 3.6s0 2.7-.05 3.6c-.04.9-.19 1.4-.31 1.7-.16.4-.35.7-.65 1-.3.3-.6.49-1 .65-.3.12-.8.27-1.7.31-.9.04-1.2.05-3.6.05s-2.7 0-3.6-.05c-.9-.04-1.4-.19-1.7-.31-.4-.16-.7-.35-1-.65-.3-.3-.49-.6-.65-1-.12-.3-.27-.8-.31-1.7C4.6 14.7 4.6 14.4 4.6 12s0-2.7.05-3.6c.04-.9.19-1.4.31-1.7.16-.4.35-.7.65-1 .3-.3.6-.49 1-.65.3-.12.8-.27 1.7-.31.9-.04 1.2-.05 3.6-.05m0-1.6c-2.45 0-2.76.01-3.72.06-.96.04-1.62.2-2.19.42-.6.23-1.1.54-1.6 1.04-.5.5-.81 1-1.04 1.6-.22.57-.38 1.23-.42 2.19C3.01 9.24 3 9.55 3 12s.01 2.76.06 3.72c.04.96.2 1.62.42 2.19.23.6.54 1.1 1.04 1.6.5.5 1 .81 1.6 1.04.57.22 1.23.38 2.19.42.96.05 1.27.06 3.72.06s2.76-.01 3.72-.06c.96-.04 1.62-.2 2.19-.42.6-.23 1.1-.54 1.6-1.04.5-.5.81-1 1.04-1.6.22-.57.38-1.23.42-2.19.05-.96.06-1.27.06-3.72s-.01-2.76-.06-3.72c-.04-.96-.2-1.62-.42-2.19a4.4 4.4 0 0 0-1.04-1.6c-.5-.5-1-.81-1.6-1.04-.57-.22-1.23-.38-2.19-.42C14.76 3.01 14.45 3 12 3zm0 4.38a4.62 4.62 0 1 0 0 9.24 4.62 4.62 0 0 0 0-9.24zm0 7.62a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm5.88-7.8a1.08 1.08 0 1 0 0-2.16 1.08 1.08 0 0 0 0 2.16z"
                        />
                      </svg>
                    )}
                    {red.icono === 'tarjeta' && (
                      <svg class="cierre__red-icono" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          d="M4 8.2h16v9.6H4zM4 8.2 8.4 6h7.2L20 8.2"
                        />
                      </svg>
                    )}
                    <span>{red.nombre}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          {/* Decisión del usuario (2026-11-10): el mapa se incrusta directamente y ocupa todo
              el ancho de la cuadrícula, debajo del texto. Aviso: Google pone sus cookies al
              cargar; el consentimiento se monta en T11. */}
          <div class="cierre__mapa-caja">
            <iframe
              class="cierre__mapa-marco"
              src={`https://www.google.com/maps?q=${encodeURIComponent(direccion.completa)}&z=16&iwloc=none&output=embed`}
              title="Mapa con la ubicación del Bar El Jardín"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </HeroScrolly>
</Base>

<script>
  import { iniciarEstadoBar } from '../scripts/horario.js';
  import { tramos } from '../data/negocio.js';

  iniciarEstadoBar(tramos);
</script>
