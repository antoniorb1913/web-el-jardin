---
/**
 * Visor de los clips del scrollytelling.
 * TEMPORAL: existe solo para revisar el troceado del vídeo (T4). Se borra en T17.
 */
import Base from '../layouts/Base.astro';
import { escenas } from '../data/escenas.js';
---

<Base
  titulo="Revisión de los clips · Bar El Jardín"
  descripcion="Página interna para revisar el troceado del vídeo del scrollytelling."
>
  <main class="mx-auto max-w-3xl space-y-12 px-6 py-12">
    <header class="space-y-4">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Los seis clips</h1>
      <p class="text-lg text-tinta-700">
        El vídeo original era un recorrido continuo sin cortes, así que los seis tramos
        están decididos a ojo. Esto es para que los veas seguidos y me digas si alguno
        empieza o acaba donde no toca.
      </p>
      <p class="rounded-xl border border-jardin-ambar/40 bg-jardin-ambar/10 p-4 text-tinta-700">
        <strong>Qué mirar:</strong> cada clip debe empezar y terminar <em>dentro de la misma
        estancia</em>. Si uno arranca a mitad de un giro, o termina justo cuando ya se ve la
        siguiente sala, ese corte está mal y lo reajusto.
      </p>
    </header>

    {escenas.map((escena, indice) => (
      <section class="space-y-3">
        <h2 class="text-xl font-semibold">
          {indice + 1}. {escena.titulo}
          <span class="ml-2 align-middle font-sans text-sm font-normal text-tinta-500">
            {escena.duracion.toFixed(1).replace('.', ',')} s · {escena.secciones.join(' · ')}
          </span>
        </h2>
        <p class="text-tinta-700">{escena.descripcion}</p>
        <video
          class="w-full rounded-xl border border-crema-200 bg-tinta-900"
          src={escena.clip}
          poster={escena.poster}
          controls
          preload="metadata"
          playsinline
        ></video>
      </section>
    ))}

    <footer class="border-t border-crema-200 pt-6 text-sm text-tinta-500">
      Página temporal de revisión. Se elimina en T17 antes de publicar.
    </footer>
  </main>
</Base>
