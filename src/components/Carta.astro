---
/**
 * Una parada de la carta: título arriba y una tira horizontal de fotos.
 *
 * La tira enseña varias piezas a la vez y se desplaza en horizontal, con enganche. Se
 * mueve con las flechas, con el arrastre o con el desplazamiento lateral del trackpad, y
 * la barra de abajo dice por dónde vas.
 *
 * Al pulsar una foto se abre en grande en un `<dialog>` del navegador, que trae el foco
 * atrapado y el Escape sin escribirlos.
 *
 * Si alguna pieza se queda sin foto, su tarjeta mantiene el sitio con el verde de la
 * marca y la «J» del logotipo, y no es pulsable: se lee como una decisión y no como una
 * imagen rota. Ahora mismo las ocho tienen foto.
 */
interface Pieza {
  nombre: string;
  foto: string | null;
}

interface Props {
  id: string;
  titulo: string;
  piezas: Pieza[];
  nota: string;
}

const { id, titulo, piezas, nota } = Astro.props;
---

<section id={id} data-seccion={id} class="relative mx-auto max-w-2xl min-h-[250dvh]">
  <div class="panel panel--carta" data-panel>
    <div class="carta" data-carta>
      <div class="carta__cabecera">
        <h2 class="titulo-apartado carta__titulo">{titulo}</h2>
        <p class="carta__nota">{nota}</p>
      </div>

      <ul class="tira" data-tira tabindex="0" aria-label={titulo}>
        {
          piezas.map((pieza, indice) => (
            <li class="tira__pieza">
              {pieza.foto ? (
                <button
                  type="button"
                  class="tira__marco"
                  data-abrir={indice}
                  aria-label={`Ver ${pieza.nombre} en grande`}
                >
                  <img
                    class="tira__foto"
                    src={`/productos/${pieza.foto}-pequena.webp`}
                    srcset={`/productos/${pieza.foto}-pequena.webp 430w, /productos/${pieza.foto}.webp 860w`}
                    sizes="(max-width: 720px) 62vw, 26vw"
                    alt={pieza.nombre}
                    width="860"
                    height="1147"
                    loading={indice < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </button>
              ) : (
                <div class="tira__marco tira__marco--hueco">
                  <span class="tira__sinfoto" aria-hidden="true">
                    J
                  </span>
                </div>
              )}
              <p class="tira__nombre">{pieza.nombre}</p>
            </li>
          ))
        }
      </ul>

      <div class="carta__pie">
        <div class="progreso" aria-hidden="true">
          <span class="progreso__relleno" data-progreso></span>
        </div>

        <div class="carta__mandos">
          <button type="button" class="carta__flecha" data-anterior aria-label="Fotos anteriores">
            <span aria-hidden="true">‹</span>
          </button>
          <button type="button" class="carta__flecha" data-siguiente aria-label="Fotos siguientes">
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* Visor de la foto ampliada. */}
  <dialog class="visor-grande" data-visor aria-label={`${titulo}: foto ampliada`}>
    <div class="visor-grande__caja">
      <img class="visor-grande__foto" data-visor-foto alt="" width="860" height="1147" />
      <p class="visor-grande__nombre" data-visor-nombre></p>
    </div>

    <button type="button" class="visor-grande__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-grande__mandos">
      <button type="button" class="visor-grande__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-grande__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>
</section>

<script>
  import { iniciarCartas } from '../scripts/carrusel.js';
  iniciarCartas();
</script>
