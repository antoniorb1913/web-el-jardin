---
/**
 * La galería del bar.
 *
 * Misma composición que las otras dos paradas de carta: título y nota en la cabecera, la
 * tira a todo el ancho y la barra con las flechas al pie.
 *
 * La tira usa la foto de 800 px; la de 1600 se pide solo al abrirla en grande.
 */
import { fotos } from '../data/galeria.js';

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];
---

<div class="carta" data-carta data-galeria>
  <div class="carta__cabecera">
    <h2 class="titulo-apartado carta__titulo">Fotos del bar</h2>
    <p class="carta__nota">Siete rincones del bar.</p>
  </div>

  <ul class="tira" data-tira tabindex="0" aria-label="Fotos del bar">
    {
      fotos.map((foto, indice) => (
        <li class="tira__pieza">
          <button
            type="button"
            class="tira__marco"
            data-abrir-foto={indice}
            aria-label={`Ver en grande: ${foto.alt}`}
          >
            <img
              class="tira__foto"
              src={`/galeria/${foto.foto}-pequena.webp`}
              srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
              sizes="(max-width: 720px) 62vw, 26vw"
              alt={foto.alt}
              width="1600"
              height="1200"
              loading={indice < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>

          <p class="tira__nombre">{pies[indice]}</p>
        </li>
      ))
    }
  </ul>

  <div class="carta__pie">
    <div class="progreso" aria-hidden="true">
      <span class="progreso__relleno" data-progreso></span>
    </div>

    <div class="carta__mandos">
      <button type="button" class="carta__flecha" data-anterior aria-label="Fotos anteriores">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="carta__flecha" data-siguiente aria-label="Fotos siguientes">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>
</div>

<script>
  import { iniciarTira } from '../scripts/carrusel.js';
  import { iniciarGaleria } from '../scripts/galeria.js';

  iniciarTira(document.querySelector('[data-galeria]'));
  iniciarGaleria();
</script>
