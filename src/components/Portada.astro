---
/**
 * La portada: el primer apartado de la película (T7 · idiomas en T16).
 *
 * La foto manda y la tipografía susurra. Un bloque pequeño, apoyado en una línea fina,
 * abajo a la izquierda: la marca, el titular en dos líneas, el párrafo aprobado y la
 * flecha de bajada.
 *
 * Vive en su propio componente porque la página existe en tres idiomas y esto es lo
 * ÚNICO que cambia entre ellas: el texto, que sale de `i18n.js`.
 */
import { t } from '../data/i18n';

interface Props {
  idioma: string;
}

const { idioma } = Astro.props;
const textos = t(idioma).portada;
---

<section id="portada" data-seccion="portada" class="relative min-h-dvh">
  <div class="panel panel--cubierta" data-panel>
    <div class="susurro">
      <p class="susurro__marca">{textos.marca}</p>

      <h1 class="susurro__titular">
        <span class="susurro__linea">{textos.lineas[0]}</span>
        <span class="susurro__linea">{textos.lineas[1]}</span>
      </h1>

      <p class="susurro__texto">{textos.texto}</p>

      {/* La bajada: flecha y etiqueta. La zona pulsable mide 44 px de alto. */}
      <a class="susurro__baja" href="#especialidades">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" aria-hidden="true">
          <path
            d="M12 4v14M6 13l6 6 6-6"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="susurro__bajatexto">{textos.baja}</span>
      </a>
    </div>
  </div>
</section>
