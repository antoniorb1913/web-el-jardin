---
/**
 * Fondo del scrollytelling (T5).
 *
 * El recorrido por el bar son 484 fotogramas (todos los del vídeo original, 24 por
 * segundo) que `app.js` dibuja en un `<canvas>` según la posición del scroll.
 *
 * Encima van **cuatro fotos nítidas**, una por clip. Cada foto es el primer
 * fotograma de su escena, así que `app.js` la enciende justo en ese punto: la
 * imagen aparece con toda su nitidez un instante y se disuelve otra vez en la
 * animación, que sigue su curso sin enterarse.
 *
 * El recorte de las fotos es el mismo que el de los fotogramas (9 % inferior fuera
 * y 16:9 centrado). Si no coincidiera, el cambio se vería como un salto de encuadre.
 */
const TOTAL = 484;

/** Cada clip dura 5,04 s a 24 fps: 121 fotogramas. */
const FOTOGRAMAS_POR_CLIP = 121;

const fotos = [
  { nombre: 'escena1', inicio: 0 },
  { nombre: 'escena2', inicio: FOTOGRAMAS_POR_CLIP },
  { nombre: 'escena3', inicio: FOTOGRAMAS_POR_CLIP * 2 },
  { nombre: 'escena4', inicio: FOTOGRAMAS_POR_CLIP * 3 },
  // La estatua no abre ninguna escena: es el último fotograma del vídeo, donde acaba
  // el recorrido. Se enciende al llegar al final de la página.
  { nombre: 'escena5', inicio: TOTAL - 1 },
];
---

<div class="portada relative" data-scrolly data-total={TOTAL}>
  <div class="sticky top-0 h-dvh overflow-hidden bg-tinta-900" data-fondo>
    <div class="fondo__capa" data-capa aria-hidden="true">
      <canvas class="fondo__lienzo" data-lienzo></canvas>

      {fotos.map((foto) => (
        <div class="foto" data-foto data-inicio={foto.inicio}>
          {/* Sin `src`: la carga `app.js` cuando la cámara se acerca a esta escena, para
              no meter 2,6 MB de fotos en la primera visita. */}
          <img
            data-fuente={`/escenas/${foto.nombre}.webp`}
            data-fuente-set={`/escenas/${foto.nombre}-movil.webp 1200w, /escenas/${foto.nombre}.webp 2400w`}
            sizes="100vw"
            alt=""
            width="2400"
            height="1350"
            decoding="async"
          />
        </div>
      ))}
    </div>
    <div class="portada__velo absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 -mt-[100dvh]">
    <slot />
  </div>
</div>

<script>
  import '../scripts/app.js';
</script>
