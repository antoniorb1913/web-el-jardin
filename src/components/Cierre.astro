---
/**
 * El cierre de la película (T10 · idiomas en T16).
 *
 * El último apartado: dónde está el bar, cuándo abre, el estado de apertura en directo, las
 * redes y el mapa —que no carga nada de Google hasta que se pulsa—.
 *
 * El estado lo escribe `horario.js` cada minuto. Las frases que usa («Cierra a las…») viajan
 * en `data-estado`, porque el guion no sabe en qué idioma está la página.
 */
import { direccion, enlaceMapa, redes } from '../data/negocio';
import { t } from '../data/i18n';

interface Props {
  idioma: string;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const u = textos.ubicacion;
const anio = new Date().getFullYear();

/** Los nombres traducidos, en el mismo orden que las URLs de `negocio.js`. */
const redesConNombre = redes.map((red, indice) => ({
  ...red,
  nombre: u.redes[indice] ?? red.nombre,
  icono: red.icono,
}));
---

<section id="ubicacion" data-seccion="ubicacion" class="relative mx-auto max-w-2xl min-h-[250dvh]">
  <div class="panel" data-panel>
    <div class="cierre texto-foto">
      <h2 class="cierre__titulo">{u.titulo}</h2>

      <div class="cierre__texto">
        <p class="cierre__direccion">
          {direccion.calle}<br />
          {direccion.poblacion} ({direccion.provincia})
        </p>

        {/* Lo enciende `horario.js`: dice si está abierto y a qué hora cierra. */}
        <p class="cierre__estado" data-estado-bar data-estado={JSON.stringify({ ...u.estado, dias: u.dias })}>
          <span class="cierre__punto" aria-hidden="true"></span>
          <span data-estado-texto>…</span>
        </p>

        <dl class="cierre__horario">
          {u.horario.map((tramo) => (
            <div>
              <dt>{tramo.dias}</dt>
              <dd>{tramo.horas}</dd>
            </div>
          ))}
        </dl>

        <p class="cierre__acciones">
          <a class="cierre__mapa" href={enlaceMapa} target="_blank" rel="noopener noreferrer">
            {u.comoLlegar}
          </a>
        </p>

        <p class="cierre__legal">
          © {anio} Bar El Jardín · Bolnuevo, Mazarrón
          <span class="cierre__enlaces">
            <a href={textos.rutas.aviso}>{textos.pie.aviso}</a>
            <a href={textos.rutas.privacidad}>{textos.pie.privacidad}</a>
          </span>
        </p>
      </div>

      <nav class="cierre__redes" aria-label={u.siguenos}>
        <p class="cierre__redes-titulo">{u.siguenos}</p>
        <ul class="cierre__redes-lista">
          {redesConNombre.map((red) => (
            <li>
              <a href={red.url} target="_blank" rel="noopener noreferrer">
                {red.icono === 'facebook' && (
                  <svg class="cierre__red-icono" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.3-.13-2.47-.13-2.44 0-4.11 1.49-4.11 4.23v2.36H7.3V13h2.32v8z"
                    />
                  </svg>
                )}
                {red.icono === 'instagram' && (
                  <svg class="cierre__red-icono" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="4.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="17" cy="7" r="1.1" fill="currentColor" />
                  </svg>
                )}
                {red.icono === 'tarjeta' && (
                  <svg class="cierre__red-icono" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="none" stroke="currentColor" stroke-width="1.5" d="M4 8.2h16v9.6H4zM4 8.2 8.4 6h7.2L20 8.2" />
                  </svg>
                )}
                <span>{red.nombre}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* El mapa no carga nada de Google hasta que se pulsa: quien entra a mirar el
          horario no recibe ni una cookie de terceros. El clic es el consentimiento. */}
      <div class="cierre__mapa-caja" data-mapa data-titulo={u.mapa.titulo}>
        <button class="cierre__mapa-boton" type="button" data-mapa-abrir>
          <img
            class="cierre__mapa-fondo"
            src="/ubicacion/fachada-pequena.webp"
            srcset="/ubicacion/fachada-pequena.webp 700w, /ubicacion/fachada.webp 1200w"
            sizes="(max-width: 900px) 92vw, 76rem"
            alt=""
            width="1200"
            height="900"
            decoding="async"
          />
          <span class="cierre__mapa-velo" aria-hidden="true"></span>
          <span class="cierre__mapa-rotulo">{u.mapa.rotulo}</span>
          <span class="cierre__mapa-aviso">{u.mapa.aviso}</span>
        </button>
      </div>
    </div>
  </div>
</section>
