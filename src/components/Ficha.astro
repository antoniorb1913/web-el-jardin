---
/**
 * Las fotos como ficha editorial.
 *
 * A la izquierda, el índice: los ocho nombres numerados con una línea fina entre cada uno.
 * A la derecha, la foto grande y su pie. Al pasar por un nombre cambia la foto; al
 * pulsarlo se queda elegido.
 *
 * Es el patrón de las webs de estudio: texto a la izquierda, imagen a la derecha, y el
 * movimiento justo para que el cambio no sea un salto.
 */
import { fotos, videos } from '../data/galeria.js';

const idioma = Astro.currentLocale?.split('-')[0] || 'es';
const video = videos[idioma] || videos.es;

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];

const entradas = [
  ...fotos.map((foto) => ({ foto: foto.foto, pie: pies[fotos.indexOf(foto)], alt: foto.alt, video: false })),
  { foto: null, pie: 'El vídeo', alt: video.alt, video: true },
];
---

<div class="ficha" data-ficha data-galeria>
  <div class="ficha__indice">
    <div class="ficha__cabecera">
      <h2 class="titulo-apartado ficha__titulo">Fotos del bar</h2>
      <p class="ficha__nota">Ocho rincones del bar, del portal a la terraza.</p>
    </div>

    <ol class="ficha__lista" data-lista-indice>
      {
        entradas.map((entrada, indice) => (
          <li class="ficha__fila">
            <button
              type="button"
              class="ficha__nombre"
              data-fila={indice}
              aria-label={entrada.video ? 'Ver el vídeo del bar' : `Ver ${entrada.pie}`}
              aria-current={indice === 0 ? 'true' : 'false'}
            >
              <span class="ficha__numero" aria-hidden="true">
                {String(indice + 1).padStart(2, '0')}
              </span>
              <span class="ficha__texto">{entrada.pie}</span>
              {entrada.video && (
                <span class="ficha__marca" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="10" height="10" focusable="false">
                    <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                  </svg>
                </span>
              )}
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="ficha__vista">
    <div class="ficha__marco">
      {
        fotos.map((foto, indice) => (
          <button
            type="button"
            class="ficha__pase"
            data-pase
            data-abrir-foto={indice}
            aria-label={`Ver en grande: ${foto.alt}`}
          >
            <img
              class="ficha__imagen"
              src={`/galeria/${foto.foto}-pequena.webp`}
              srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
              sizes="(max-width: 900px) 92vw, 46vw"
              alt={foto.alt}
              width="800"
              height="600"
              loading={indice < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
        ))
      }

      <div class="ficha__pase ficha__pase--video" data-pase data-video data-archivo={video.archivo}>
        <img
          class="ficha__imagen"
          src={video.poster}
          alt=""
          width="720"
          height="1280"
          loading="lazy"
          decoding="async"
        />

        <button type="button" class="ficha__play" data-video-abrir aria-label="Ver el vídeo del bar">
          <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
          </svg>
        </button>

        <dialog class="visor-video" data-visor-video aria-label={video.alt}>
          <video
            class="visor-video__player"
            data-video-player
            controls
            playsinline
            preload="none"
            poster={video.poster}
            aria-label={video.alt}
          ></video>

          <button type="button" class="visor-video__cerrar" data-video-cerrar aria-label="Cerrar">
            <span aria-hidden="true">×</span>
          </button>
        </dialog>
      </div>
    </div>

    <p class="ficha__pie" data-pie>{fotos[0].alt}</p>
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>
</div>

<script>
  import { iniciarFicha } from '../scripts/ficha.js';
  import { iniciarGaleria } from '../scripts/galeria.js';
  import { iniciarVideo } from '../scripts/video.js';

  iniciarFicha();
  iniciarGaleria();
  iniciarVideo();
</script>
