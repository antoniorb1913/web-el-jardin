---
/**
 * El muestrario del bar.
 *
 * Una foto grande contenida —no a sangre— con una tira de miniaturas debajo. Al pasar por
 * encima de una miniatura, la grande cambia con un cruce corto; al pulsarla se queda
 * elegida. La grande abre el visor y el vídeo se reproduce en su ventana.
 *
 * Es el mismo contenido que la galería anterior, con otra jerarquía: aquí manda la foto
 * grande y las demás están a su servicio.
 */
import { fotos, videos } from '../data/galeria.js';

const idioma = Astro.currentLocale?.split('-')[0] || 'es';
const video = videos[idioma] || videos.es;

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];
---

<div class="muestrario" data-muestrario data-galeria>
  <div class="muestrario__cabecera">
    <h2 class="titulo-apartado muestrario__titulo">Fotos del bar</h2>
    <p class="muestrario__cuenta" aria-hidden="true">
      <span data-cuenta>01</span>
      <span class="muestrario__total">/ {String(fotos.length + 1).padStart(2, '0')}</span>
    </p>
  </div>

  {/* La foto grande: las diapositivas están apiladas y se cruzan. */}
  <div class="muestrario__marco">
    {
      fotos.map((foto, indice) => (
        <button
          type="button"
          class="muestrario__pase"
          data-pase
          data-abrir-foto={indice}
          aria-label={`Ver en grande: ${foto.alt}`}
        >
          <img
            class="muestrario__imagen"
            src={`/galeria/${foto.foto}-pequena.webp`}
            srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
            sizes="(max-width: 900px) 92vw, 62vw"
            alt={foto.alt}
            width="800"
            height="600"
            loading={indice < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))
    }

    <div class="muestrario__pase muestrario__pase--video" data-pase data-video data-archivo={video.archivo}>
      <img
        class="muestrario__imagen"
        src={video.poster}
        alt=""
        width="720"
        height="1280"
        loading="lazy"
        decoding="async"
      />

      <button type="button" class="muestrario__play" data-video-abrir aria-label="Ver el vídeo del bar">
        <svg viewBox="0 0 24 24" width="26" height="26" focusable="false" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
        </svg>
      </button>

      <dialog class="visor-video" data-visor-video aria-label={video.alt}>
        <video
          class="visor-video__player"
          data-video-player
          controls
          playsinline
          preload="none"
          poster={video.poster}
          aria-label={video.alt}
        ></video>

        <button type="button" class="visor-video__cerrar" data-video-cerrar aria-label="Cerrar">
          <span aria-hidden="true">×</span>
        </button>
      </dialog>
    </div>

    <p class="muestrario__leyenda">
      <span class="muestrario__nombre" data-nombre>{pies[0]}</span>
    </p>
  </div>

  {/* La tira de miniaturas. */}
  <div class="muestrario__tira" role="group" aria-label="Elegir foto">
    {
      [...fotos.map((f) => ({ foto: f.foto, pie: pies[fotos.indexOf(f)], video: false })),
       { foto: null, pie: 'El vídeo', video: true }].map((pieza, indice) => (
        <button
          type="button"
          class="muestrario__mini"
          data-mini={indice}
          aria-label={pieza.video ? 'Ver el vídeo del bar' : `Ver ${pieza.pie}`}
        >
          {pieza.video ? (
            <img class="muestrario__mini-foto" src={video.poster} alt="" width="720" height="1280" loading="lazy" decoding="async" />
          ) : (
            <img
              class="muestrario__mini-foto"
              src={`/galeria/${pieza.foto}-pequena.webp`}
              alt=""
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          )}
          <span class="muestrario__mini-velo" aria-hidden="true"></span>
          {pieza.video && (
            <span class="muestrario__mini-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="11" height="11" focusable="false">
                <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
              </svg>
            </span>
          )}
        </button>
      ))
    }
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>

  <p class="solo-lectores" data-anuncio aria-live="polite"></p>
</div>

<script>
  import { iniciarMuestrario } from '../scripts/muestrario.js';
  import { iniciarGaleria } from '../scripts/galeria.js';
  import { iniciarVideo } from '../scripts/video.js';

  iniciarMuestrario();
  iniciarGaleria();
  iniciarVideo();
</script>
