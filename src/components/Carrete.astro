---
/**
 * El carrete del bar.
 *
 * Las fotos van montadas como un negativo: una tira oscura con sus perforaciones arriba y
 * abajo, los fotogramas dentro y el número de cada uno escrito debajo, como en una hoja de
 * contactos.
 *
 * No es una rejilla de tarjetas: es un objeto. La tira se arrastra en horizontal y cada
 * fotograma se abre al pulsarlo.
 */
import { fotos } from '../data/galeria.js';

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];
---

<div class="carrete" data-galeria>
  <div class="carrete__cabecera">
    <h2 class="titulo-apartado carrete__titulo">Fotos del bar</h2>
    <p class="carrete__nota">Arrastra la tira.</p>
  </div>

  <div class="carrete__tira" tabindex="0" aria-label="Fotos del bar, arrastra para ver más">
    <span class="carrete__perforaciones carrete__perforaciones--arriba" aria-hidden="true"></span>

    <ul class="carrete__fotogramas">
      {
        fotos.map((foto, indice) => (
          <li class="carrete__fotograma">
            <button
              type="button"
              class="carrete__marco"
              data-abrir-foto={indice}
              aria-label={`Ver en grande: ${foto.alt}`}
            >
              <img
                class="carrete__foto"
                src={`/galeria/${foto.foto}-pequena.webp`}
                srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
                sizes="(max-width: 720px) 58vw, 24vw"
                alt={foto.alt}
                width="800"
                height="600"
                loading={indice < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>

            <p class="carrete__leyenda">
              <span class="carrete__numero" aria-hidden="true">{String(indice + 1).padStart(2, '0')}A</span>
              <span class="carrete__nombre">{pies[indice]}</span>
            </p>
          </li>
        ))
      }

    </ul>

    <span class="carrete__perforaciones carrete__perforaciones--abajo" aria-hidden="true"></span>
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>
</div>

<script>
  import { iniciarGaleria } from '../scripts/galeria.js';
  import { iniciarArrastre } from '../scripts/carrete.js';

  iniciarGaleria();
  iniciarArrastre();
</script>
