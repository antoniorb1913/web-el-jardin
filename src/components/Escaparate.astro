---
/**
 * El escaparate del bar.
 *
 * Cada foto ocupa la pantalla entera, de borde a borde, y se cambia con un cruce: la que
 * entra aparece encima mientras la anterior se apaga. La foto activa se mueve muy despacio
 * (18 s), como si la cámara respirara.
 *
 * Todo el cromo es mínimo: el rótulo arriba a la izquierda, el pie con el número y el
 * nombre abajo, y una fila de marcas finas abajo a la derecha para saltar de una a otra.
 * No hay tarjetas, ni marcos, ni barra de progreso.
 *
 * El vídeo es una diapositiva más: su póster ocupa la pantalla y el play va en el centro.
 */
import { fotos, videos } from '../data/galeria.js';

const idioma = Astro.currentLocale?.split('-')[0] || 'es';
const video = videos[idioma] || videos.es;

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];

const total = fotos.length + 1;
---

<div class="escaparate" data-escaparate data-galeria>
  <h2 class="escaparate__rotulo">Fotos del bar</h2>

  <div class="escaparate__pila">
    {
      fotos.map((foto, indice) => (
        <button
          type="button"
          class="escaparate__pase"
          data-pase
          data-abrir-foto={indice}
          aria-label={`Ver en grande: ${foto.alt}`}
        >
          <img
            class="escaparate__imagen"
            src={`/galeria/${foto.foto}.webp`}
            srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
            sizes="100vw"
            alt={foto.alt}
            width="1600"
            height="1200"
            loading={indice < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))
    }

    <div class="escaparate__pase escaparate__pase--video" data-pase data-video data-archivo={video.archivo}>
      <img
        class="escaparate__imagen"
        src={video.poster}
        alt=""
        width="720"
        height="1280"
        loading="lazy"
        decoding="async"
      />

      <button type="button" class="escaparate__play" data-video-abrir aria-label="Ver el vídeo del bar">
        <svg viewBox="0 0 24 24" width="22" height="22" focusable="false" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
        </svg>
      </button>

      {/* El visor va dentro de la diapositiva del vídeo: `video.js` lo busca ahí. */}
      <dialog class="visor-video" data-visor-video aria-label={video.alt}>
        <video
          class="visor-video__player"
          data-video-player
          controls
          playsinline
          preload="none"
          poster={video.poster}
          aria-label={video.alt}
        ></video>

        <button type="button" class="visor-video__cerrar" data-video-cerrar aria-label="Cerrar">
          <span aria-hidden="true">×</span>
        </button>
      </dialog>
    </div>
  </div>

  {/* Velo solo abajo: el pie necesita fondo y la foto, no. */}
  <span class="escaparate__velo" aria-hidden="true"></span>

  <div class="escaparate__pie">
    <p class="escaparate__leyenda">
      <span class="escaparate__cuenta" data-cuenta>01</span>
      <span class="escaparate__nombre" data-nombre>{pies[0]}</span>
    </p>

    <div class="escaparate__saltos" role="group" aria-label="Ir a una foto">
      {
        [...pies, 'El vídeo'].map((nombre, indice) => (
          <button
            type="button"
            class="escaparate__salto"
            data-salto={indice}
            aria-label={`Ir a ${nombre}`}
          >
            <span aria-hidden="true"></span>
          </button>
        ))
      }
    </div>

    <div class="escaparate__flechas">
      <button type="button" class="escaparate__flecha" data-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="escaparate__flecha" data-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>

  <p class="solo-lectores" data-anuncio aria-live="polite"></p>
</div>

<script>
  import { iniciarEscaparate } from '../scripts/escaparate.js';
  import { iniciarGaleria } from '../scripts/galeria.js';
  import { iniciarVideo } from '../scripts/video.js';

  iniciarEscaparate();
  iniciarGaleria();
  iniciarVideo();
</script>
