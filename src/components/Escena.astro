---
/**
 * El escenario del bar (T9 · idiomas en T16).
 *
 * Un número enorme de fondo, el titular en dos líneas grandes a la izquierda y la foto
 * delante tapando parte del titular. Abajo, una fila de rayas y las flechas.
 *
 * El titular va en la redonda de la casa (Fredoka) porque así lo pide la composición: la
 * caligráfica se queda para el nombre pequeño del pie.
 *
 * **Los titulares viajan al guion** por `data-titulos`: antes había dos listas —una aquí y
 * otra en `escena.js`— y ya no coincidían. Ahora hay una sola, la del idioma.
 */
import { fotos } from '../data/galeria.js';
import { t } from '../data/i18n';

interface Props {
  idioma: string;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const pies = textos.fotos.pies;

/** Los textos alternativos se quedan por idioma en `i18n.js`. */
const fotosConAlt = fotos.map((foto, indice) => ({
  ...foto,
  alt: textos.fotos.alt[indice] ?? foto.alt,
}));

// El titular se parte en dos líneas cuando hay espacio: «La / entrada».
function enDosLineas(texto) {
  const palabras = texto.split(' ');
  if (palabras.length === 1) return [palabras[0], ''];
  const medio = Math.ceil(palabras.length / 2);
  return [palabras.slice(0, medio).join(' '), palabras.slice(medio).join(' ')];
}

const lineas = pies.map(enDosLineas);
---

<div class="escena" id="fotos" data-seccion="fotos" data-escena data-galeria data-titulos={JSON.stringify(pies)}>
  <span class="escena__numero">{textos.fotos.frase}</span>

  {/* Titular y enlace van juntos: así el enlace cae siempre debajo del titular, tenga una
      línea o tres. */}
  <div class="escena__texto">
    <h2 class="escena__titulo">
      <span data-linea-1>{lineas[0][0]}</span>
      <span data-linea-2>{lineas[0][1]}</span>
    </h2>

    <a class="escena__enlace" href="#" data-abrir-actual>{textos.fotos.verEnGrande}</a>
  </div>

  <div class="escena__rayas" role="group" aria-label={textos.fotos.elegir}>
    {
      pies.map((pie, indice) => (
        <button type="button" class="escena__raya" data-raya={indice} aria-label={`${textos.fotos.irA} ${pie}`}>
          <span aria-hidden="true"></span>
        </button>
      ))
    }
  </div>

  <div class="escena__flechas">
    <button type="button" class="escena__flecha" data-anterior aria-label={textos.fotos.anterior}>
      <span aria-hidden="true">‹</span>
    </button>
    <button type="button" class="escena__flecha" data-siguiente aria-label={textos.fotos.siguiente}>
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="escena__fotos">
    {
      fotosConAlt.map((foto, indice) => (
        <button
          type="button"
          class="escena__foto"
          data-pase
          data-abrir-foto={indice}
          aria-label={`${textos.fotos.verEnGrande}: ${foto.alt}`}
        >
          <img
            src={`/galeria/${foto.foto}-pequena.webp`}
            srcset={`/galeria/${foto.foto}-pequena.webp 600w, /galeria/${foto.foto}.webp 1200w`}
            sizes="(max-width: 900px) 86vw, 35vw"
            alt={foto.alt}
            width="800"
            height="600"
            loading={indice < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      ))
    }
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label={textos.fotos.verEnGrande}>
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1200" height="900" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label={textos.carta.cerrar}>
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label={textos.fotos.anterior}>
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label={textos.fotos.siguiente}>
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>

  <p class="solo-lectores" data-anuncio aria-live="polite"></p>
</div>

<script>
  import { iniciarEscena } from '../scripts/escena.js';
  import { iniciarGaleria } from '../scripts/galeria.js';

  iniciarEscena();
  iniciarGaleria();
</script>
