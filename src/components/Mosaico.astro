---
/**
 * El mosaico del bar.
 *
 * Ocho marcos iguales en dos filas. Nada destaca sobre nada: es una pared de fotos que se
 * lee de un vistazo, sin tira, sin contador y sin flechas.
 *
 * El movimiento es mínimo y todo suave: al llegar al apartado las fotos suben y aparecen
 * escalonadas (60 ms entre una y otra), y al pasar por encima cada una se acerca un 3 % y
 * su nombre aparece. Nada más.
 */
import { fotos, videos } from '../data/galeria.js';

const idioma = Astro.currentLocale?.split('-')[0] || 'es';
const video = videos[idioma] || videos.es;

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];
---

<div class="mosaico" data-mosaico data-galeria>
  <div class="mosaico__cabecera">
    <h2 class="titulo-apartado mosaico__titulo">Fotos del bar</h2>
    <p class="mosaico__nota">Toca una foto y se abre entera.</p>
  </div>

  <div class="mosaico__marco">
    {
      fotos.map((foto, indice) => (
        <button
          type="button"
          class="mosaico__pieza"
          data-abrir-foto={indice}
          style={`--turno: ${indice}`}
          aria-label={`Ver en grande: ${foto.alt}`}
        >
          <img
            class="mosaico__foto"
            src={`/galeria/${foto.foto}-pequena.webp`}
            srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
            sizes="(max-width: 720px) 46vw, 24vw"
            alt={foto.alt}
            width="800"
            height="600"
            loading={indice < 4 ? 'eager' : 'lazy'}
            decoding="async"
          />

          <span class="mosaico__nombre">{pies[indice]}</span>
        </button>
      ))
    }

    <div class="mosaico__pieza mosaico__pieza--video" data-video data-archivo={video.archivo} style="--turno: 7">
      <img
        class="mosaico__foto"
        src={video.poster}
        alt=""
        width="720"
        height="1280"
        loading="lazy"
        decoding="async"
      />

      <button type="button" class="mosaico__play" data-video-abrir aria-label="Ver el vídeo del bar">
        <svg viewBox="0 0 24 24" width="18" height="18" focusable="false" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
        </svg>
      </button>

      <span class="mosaico__nombre">El vídeo</span>

      <dialog class="visor-video" data-visor-video aria-label={video.alt}>
        <video
          class="visor-video__player"
          data-video-player
          controls
          playsinline
          preload="none"
          poster={video.poster}
          aria-label={video.alt}
        ></video>

        <button type="button" class="visor-video__cerrar" data-video-cerrar aria-label="Cerrar">
          <span aria-hidden="true">×</span>
        </button>
      </dialog>
    </div>
  </div>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>
</div>

<script>
  import { iniciarGaleria } from '../scripts/galeria.js';
  import { iniciarVideo } from '../scripts/video.js';

  iniciarGaleria();
  iniciarVideo();
</script>
