---
/**
 * El mirador del bar.
 *
 * Las fotos en profundidad: la que está delante se ve entera y las demás se van hacia
 * atrás, más pequeñas, giradas y apagadas. Avanza sola cada cinco segundos y medio, muy
 * despacio, y se para cuando pones el ratón encima.
 *
 * El movimiento va con curvas largas y un balanceo de seis píxeles: no es un carrusel que
 * llama la atención, es una ventana que respira.
 */
import { fotos } from '../data/galeria.js';

const pies = [
  'La entrada',
  'El patio',
  'La terraza',
  'La barra',
  'La estatua',
  'Las mesas',
  'Bolnuevo',
];
---

<div class="mirador" data-mirador data-galeria>
  <h2 class="titulo-apartado mirador__titulo">Fotos del bar</h2>

  <div class="mirador__escena">
    <div class="mirador__pista">
      {
        fotos.map((foto, indice) => (
          <button
            type="button"
            class="mirador__foto"
            data-abrir-foto={indice}
            data-foto={indice}
            data-pie={pies[indice]}
            aria-label={`Ver en grande: ${foto.alt}`}
          >
            <img
              src={`/galeria/${foto.foto}-pequena.webp`}
              srcset={`/galeria/${foto.foto}-pequena.webp 800w, /galeria/${foto.foto}.webp 1600w`}
              sizes="(max-width: 900px) 74vw, 42vw"
              alt={foto.alt}
              width="800"
              height="600"
              loading={indice < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
        ))
      }
    </div>

    <button type="button" class="mirador__flecha mirador__flecha--atras" data-anterior aria-label="Foto anterior">
      <span aria-hidden="true">‹</span>
    </button>
    <button type="button" class="mirador__flecha mirador__flecha--delante" data-siguiente aria-label="Foto siguiente">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <p class="mirador__pie">
    <span class="mirador__nombre" data-nombre>{pies[0]}</span>
  </p>

  <dialog class="visor-foto" data-visor-galeria aria-label="Foto del bar en grande">
    <div class="visor-foto__caja">
      <img class="visor-foto__imagen" data-visor-imagen alt="" width="1600" height="1200" />
      <p class="visor-foto__pie" data-visor-pie></p>
    </div>

    <button type="button" class="visor-foto__cerrar" data-visor-cerrar aria-label="Cerrar">
      <span aria-hidden="true">×</span>
    </button>

    <div class="visor-foto__mandos">
      <button type="button" class="visor-foto__flecha" data-visor-anterior aria-label="Foto anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="visor-foto__flecha" data-visor-siguiente aria-label="Foto siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </dialog>
</div>

<script>
  import { iniciarMirador } from '../scripts/mirador.js';
  import { iniciarGaleria } from '../scripts/galeria.js';

  iniciarMirador();
  iniciarGaleria();
</script>
